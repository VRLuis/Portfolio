---
const { sectionTitle, sectionIcon } = Astro.props;
---

<div class="flex flex-col items-center text-center py-8">
    <div class="mb-4 text-accent">
        {sectionIcon}
    </div>
    <h2 class="text-3xl md:text-4xl font-bold text-main-text mb-4">{sectionTitle}</h2>
    <div class="w-24 h-0.5 bg-accent rounded-full shadow-md shadow-accent/50"></div>
</div>