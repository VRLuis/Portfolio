---
const { 
    centerName,
    formationName,
    startDate,
    endDate,
    formationLocation
} = Astro.props;
---

<div class="w-full bg-card p-6 rounded-lg border border-card shadow-md">
    <h2 class="text-xl md:text-2xl font-bold mb-2">{ formationName }</h2>
    <h3 class="text-lg font-semibold text-accent">{ centerName }</h3>
    
    <div class="mt-3 flex flex-col gap-1">
        <span class="text-base text-secondary-text">{ startDate } - { endDate }</span>
        <span class="text-base font-medium">{ formationLocation }</span>
    </div>
</div>