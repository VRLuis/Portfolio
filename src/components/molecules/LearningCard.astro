---
const { 
    learningName,
    learningDescription,
    learningIcon
} = Astro.props;

const basePath = import.meta.env.BASE_URL || '/';
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const learningIconSrc = learningIcon?.startsWith('http') || learningIcon?.startsWith('//')
    ? learningIcon
    : `${normalizedBasePath}${learningIcon}`;
---

<div class="w-full bg-card p-5 rounded-lg transition-all">
    <h1 class="text-xl text-center font-bold mb-5">{ learningName }</h1>
    <p class="text-lg font-semibold text-secondary-text">{ learningDescription }</p>
    
    <img src={ learningIconSrc } alt={ learningName } class="w-20 mx-auto mt-5"/>
</div>