---
import TechIcon from "../atoms/TechIcon.astro"

const {
    technologiesName,
    technologies = [],
} = Astro.props

const techList = Array.isArray(technologies) ? technologies : []
---

<div class="w-full bg-card p-8 rounded-lg border border-card shadow-md">
    <h2 class="text-xl md:text-2xl font-bold mb-6">{technologiesName}</h2>

    <div class="flex flex-wrap gap-5 items-center justify-center">
        {techList.map((tech: string) => (
            <TechIcon techIcon={tech}/>
        ))}
    </div>
</div>