---
import ProjectCard from "../molecules/ProjectCard.astro";

const { projects, translations } = Astro.props;
---

<div class="relative w-full max-w-6xl mx-auto px-4" data-carousel data-total={projects.length}>
    <div class="py-10 w-full">
        <div class="flex gap-8 transition-transform duration-500 ease-in-out" data-carousel-track>
            {projects.map((project, index) => (
                <div class="carousel-slide flex-shrink-0" data-slide={index}>
                    <ProjectCard
                        projectName={project.projectName}
                        projectDescription={project.projectDescription}
                        projectImage={project.projectImage}
                        projectLink={project.projectLink}
                        projectWeb={project.projectWeb}
                        projectTechnologies={project.projectTechnologies}
                        inProgress={project.inProgress}
                        translations={translations}
                    />
                </div>
            ))}
        </div>
    </div>

    <button class="absolute left-4 top-1/2 -translate-y-1/2 bg-card/80 border border-card text-white rounded-full w-10 h-10 flex items-center justify-center hover:bg-secondary-accent hover:shadow-md hover:shadow-accent/25 transition-all z-10 cursor-pointer" data-carousel-prev aria-label={translations.buttons.prevSlide}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 19l-7 -7l7 -7"/></svg>
    </button>

    <button class="absolute right-4 top-1/2 -translate-y-1/2 bg-card/80 border border-card text-white rounded-full w-10 h-10 flex items-center justify-center hover:bg-secondary-accent hover:shadow-md hover:shadow-accent/25 transition-all z-10 cursor-pointer" data-carousel-next aria-label={translations.buttons.nextSlide}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 5l7 7l-7 7"/></svg>
    </button>

    <div class="flex justify-center gap-2 mt-6" data-carousel-dots>
        {projects.map((_, index) => (
            <button class={`w-3 h-3 rounded-full transition-all ${index === 0 ? 'bg-accent shadow-md shadow-accent/50' : 'bg-white/20 hover:bg-white/40'}`} data-carousel-dot={index} aria-label={`Go to slide ${index + 1}`} />
        ))}
    </div>
</div>

<script>
    document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const track = carousel.querySelector('[data-carousel-track]');
        const slides = carousel.querySelectorAll('.carousel-slide');
        const prevBtn = carousel.querySelector('[data-carousel-prev]');
        const nextBtn = carousel.querySelector('[data-carousel-next]');
        const dots = carousel.querySelectorAll('[data-carousel-dot]');
        const totalSlides = slides.length;
        let current = 0;

        const updateCarousel = () => {
            const container = carousel.querySelector('[data-carousel-track]')?.parentElement;
            const containerWidth = container?.clientWidth || 0;
            const slideWidth = slides[0]?.clientWidth || 0;
            const gap = 32;
            const offset = (containerWidth - slideWidth) / 2;
            const slideOffset = current * (slideWidth + gap);
            const translateX = -(slideOffset - offset);

            if (track) {
                track.style.transform = `translateX(${translateX}px)`;
            }

            slides.forEach((slide, i) => {
                const distance = Math.abs(i - current);
                if (distance === 0) {
                    slide.classList.add('active');
                    slide.classList.remove('adjacent');
                } else if (distance === 1) {
                    slide.classList.add('adjacent');
                    slide.classList.remove('active');
                } else {
                    slide.classList.remove('active');
                    slide.classList.remove('adjacent');
                }
            });

            dots.forEach((dot, i) => {
                dot.className = i === current
                    ? 'w-3 h-3 rounded-full transition-all bg-accent shadow-md shadow-accent/50'
                    : 'w-3 h-3 rounded-full transition-all bg-white/20 hover:bg-white/40';
            });
        };

        const goTo = (index: number) => {
            current = index;
            updateCarousel();
        };

        prevBtn?.addEventListener('click', () => goTo((current - 1 + totalSlides) % totalSlides));
        nextBtn?.addEventListener('click', () => goTo((current + 1) % totalSlides));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

        window.addEventListener('resize', updateCarousel);

        setTimeout(updateCarousel, 100);
    });
</script>

<style>
    .carousel-slide {
        flex-shrink: 0;
        width: 580px;
        opacity: 0.15;
        filter: brightness(0.4) blur(3px);
        transform: scale(0.8);
        transition: all 0.5s ease-in-out;
    }

    .carousel-slide.adjacent {
        opacity: 0.5;
        filter: brightness(0.6) blur(1px);
        transform: scale(0.9);
    }

    .carousel-slide.active {
        opacity: 1;
        filter: brightness(1) blur(0);
        transform: scale(1);
    }
</style>
